# ApexSMM Production Apache Configuration
Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Block access to sensitive files
    RewriteRule ^\.env.*$ - [F,L]
    RewriteRule ^\.git.*$ - [F,L]
    RewriteRule ^database/.*$ - [F,L]
    RewriteRule ^storage/logs/.*$ - [F,L]
    RewriteRule ^storage/cache/.*$ - [F,L]
    RewriteRule ^storage/backups/.*$ - [F,L]
    RewriteRule ^includes/.*$ - [F,L]

    # Friendly URL Rewrites
    RewriteRule ^dashboard/?$ user/dashboard.php [L,QSA]
    RewriteRule ^services/?$ services.php [L,QSA]
    RewriteRule ^faq/?$ faq.php [L,QSA]
    RewriteRule ^how-it-works/?$ how-it-works.php [L,QSA]
    RewriteRule ^contact/?$ contact.php [L,QSA]
    RewriteRule ^login/?$ login.php [L,QSA]
    RewriteRule ^register/?$ register.php [L,QSA]
    RewriteRule ^logout/?$ logout.php [L,QSA]
    RewriteRule ^admin/?$ admin/index.php [L,QSA]

    # If requested file or directory does not exist, pass to index.php or 404
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^errors/([0-9]{3})/?$ errors/$1.php [L,QSA]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Custom Error Pages
ErrorDocument 400 /errors/400.php
ErrorDocument 401 /errors/401.php
ErrorDocument 403 /errors/403.php
ErrorDocument 404 /errors/404.php
ErrorDocument 405 /errors/405.php
ErrorDocument 419 /errors/419.php
ErrorDocument 429 /errors/429.php
ErrorDocument 500 /errors/500.php
ErrorDocument 503 /errors/503.php
